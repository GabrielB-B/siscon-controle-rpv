FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=altere-esta-chave-localmente
SESSION_COOKIE_SECURE=0
CSRF_ENABLED=1
APP_HOST=127.0.0.1
APP_PORT=8080
APP_THREADS=8

# Banco local de desenvolvimento. A pasta instance/ fica fora do Git.
DATABASE_URL=sqlite:///instance/controle_rpv.db

# Admin inicial opcional. Se vazio, o sistema gera senha local em instance/.
# ADMIN_INITIAL_PASSWORD=

# Notificacoes locais por arquivo durante desenvolvimento.
NOTIFICATION_DELIVERY_MODE=file
NOTIFICATION_OUTBOX_DIR=instance/notifications

# SMTP/SMS somente com credenciais locais reais no .env privado.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_AUTH_TOKEN=
