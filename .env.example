FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-esta-chave-antes-de-distribuir
SESSION_COOKIE_SECURE=0
APP_HOST=127.0.0.1
APP_PORT=8080
APP_THREADS=8

# Recuperacao de senha
# Padrao local: nao envia email/SMS real; grava JSON em instance/notifications.
NOTIFICATION_DELIVERY_MODE=file
LOGIN_THROTTLE_MAX_FAILURES=5
LOGIN_THROTTLE_WINDOW_SECONDS=60
PASSWORD_RESET_SEND_THROTTLE_MAX_ATTEMPTS=3
PASSWORD_RESET_SEND_THROTTLE_WINDOW_SECONDS=600
# Padrao recomendado: throttle persistente em arquivo SQLite dentro de instance/.
# REQUEST_THROTTLE_BACKEND=sqlite
# REQUEST_THROTTLE_STORAGE_PATH=
# Observabilidade operacional
# OBSERVABILITY_ENABLE_FILE_LOGGING=1
# APP_LOG_LEVEL=INFO
# APP_LOG_DIR=instance/logs
# APP_LOG_FILE=app.log
# APP_LOG_MAX_BYTES=2097152
# APP_LOG_BACKUP_COUNT=5
# APP_SLOW_REQUEST_THRESHOLD_MS=750
# Para envio real por email, configure SMTP e use qualquer modo diferente de "file".
# NOTIFICATION_DELIVERY_MODE=smtp
# EMAIL_FROM_ADDRESS=nao-responda@siscon.local
# SMTP_HOST=smtp.exemplo.local
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1

# Alternativa simples para email real: Brevo API transacional.
# Crie uma conta Brevo, cadastre/verifique o remetente e configure a chave API.
# NOTIFICATION_DELIVERY_MODE=brevo_api
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=nao-responda@seudominio.com
# BREVO_SENDER_NAME=SISCON

# Para SMS real, configure um webhook HTTP que receba {"to": "...", "message": "..."}.
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_AUTH_TOKEN=
# SMS_WEBHOOK_AUTH_TYPE=bearer
# SMS_WEBHOOK_PAYLOAD_STYLE=generic

# SMS open source com Gammu exige modem GSM/4G USB + chip com SMS.
# Exemplo para pajikos/sms-gammu-gateway:
# SMS_WEBHOOK_URL=http://127.0.0.1:5000/sms
# SMS_WEBHOOK_AUTH_TYPE=basic
# SMS_WEBHOOK_USERNAME=admin
# SMS_WEBHOOK_PASSWORD=password
# SMS_WEBHOOK_PAYLOAD_STYLE=gammu

# SQLite local padrao
DATABASE_URL=sqlite:///instance/controle_rpv.db

# Exemplo futuro para MySQL
# DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/controle_rpv?charset=utf8mb4
